# PostCraft Backend Environment Variables
# OpenAI 字段对齐 studyx-agent-backend/config/api_keys.local.json
# 也可复制 studyx 的 json 到 PostCraft/config/api_keys.local.json，或设置：
# API_KEYS_FILE=/path/to/studyx-agent-backend/config/api_keys.local.json

# LLM provider: deepseek | openai
LLM_PROVIDER=deepseek

# DeepSeek（主模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（备用 LLM + 封面配图）
# 也可复制 studyx-agent-backend/config/api_keys.local.json 到 PostCraft/config/api_keys.local.json
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_IMAGE_MODEL=gpt-image-2
# LLM 走直连；配图 API 对齐 studyx，不受此项影响（仍使用 SDK 默认直连）
OPENAI_SKIP_PROXY=true

# Database — 默认本地 SQLite；Supabase 见 Project Settings → Database → URI
# DATABASE_URL=postgresql://postgres.fajfbidwctcjwrhtvdvs:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Storage（IMAGE_STORAGE=supabase 时用于配图/上传）
# SUPABASE_URL=https://fajfbidwctcjwrhtvdvs.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=postcraft-images
# IMAGE_STORAGE=local

# Server
DEBUG=true
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Auth（本地开发默认关闭，与旧行为兼容；生产请设 POSTCRAFT_ENV=production）
POSTCRAFT_ENV=development
JWT_SECRET=请替换为随机字符串
JWT_EXPIRE_MINUTES=10080
AUTH_REQUIRED=false
ALLOW_REGISTER=true
